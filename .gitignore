# Local development scripts
# The [G] launcher became a thin wrapper over Ed's local P06_git_sync engine (2026-10), so it cannot run for anyone else; keep it local. Brackets escaped so the rule is literal, root-anchored to cover only top-level launchers.
/\[G\]_*.bat
# [V]_*.bat stays tracked: it uses %~dp0 and carries no local path.

# project-sync session logs (optional, in-repo)
09_docs/project-sync-log/

# Node
node_modules/
npm-debug.log
yarn-error.log

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build
dist/
build/
.next/
out/
